# Copy to .env for local development. `make dev` uses these defaults.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres (docker compose default). Local cluster alternative: postgres://postgres:parity@localhost:5432/parity
DATABASE_URL=postgres://parity:parity@localhost:5432/parity
# Redis
REDIS_URL=redis://localhost:6379
# Object storage (MinIO in docker compose). S3-compatible.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=parity-captures
S3_ACCESS_KEY_ID=parity
S3_SECRET_ACCESS_KEY=parityparity

# Observability (all optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=parity-api
SENTRY_DSN=

# Product name used in the identified bot user agent and public docs
PRODUCT_NAME=Parity
BOT_CONTACT_URL=https://example.invalid/bot
BOT_CONTACT_EMAIL=bot@example.invalid
